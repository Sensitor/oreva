# Copy to .env.local (never committed). EXPO_PUBLIC_* values are bundled into the
# app and are public by design: never put a secret in them.

# development | staging | production (decision P-10). EAS build profiles set this.
APP_VARIANT=development
# Production identifier. Do not change after the first store submission.
APP_ID_BASE=com.oreva.app

# Crash reporting (EU region). Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Data source: "demo" (fictional data, development and staging only) or
# "unavailable" (no data). Production builds refuse "demo" (decision C-3).
EXPO_PUBLIC_DATA_SOURCE=

# Discover map A/B (decision note 0002). Public Mapbox token (pk.), set as an
# EAS environment variable. Without it, the app shows Apple Maps.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional custom ORÉVA style from Mapbox Studio (mapbox://styles/...).
EXPO_PUBLIC_MAPBOX_STYLE_URL=
# Android only, optional: Google Maps key for the react-native-maps variant.
# GOOGLE_MAPS_ANDROID_API_KEY=
# Android only, if the Mapbox SDK download asks for it: secret token (sk.,
# DOWNLOADS:READ), EAS secret only.
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Phase 2 and later (names only):
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=
# EXPO_PUBLIC_MAPS_KEY=
# SENTRY_AUTH_TOKEN=   # EAS / CI secret only, for source maps

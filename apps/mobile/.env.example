# Copy to .env.local (never committed). EXPO_PUBLIC_* values are bundled into the
# app and are public by design: never put a secret in them.

# development | staging | production (decision P-10). EAS build profiles set this.
APP_VARIANT=development
# Production identifier. Do not change after the first store submission.
APP_ID_BASE=com.oreva.app

# Crash reporting (EU region). Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Phase 2 and later (names only):
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=
# EXPO_PUBLIC_MAPS_KEY=
# SENTRY_AUTH_TOKEN=   # EAS / CI secret only, for source maps

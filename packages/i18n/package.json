{
  "name": "@oreva/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "ORÉVA translations (EN default and fallback, FR, RU), locale detection and Intl formatters.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "27.0.1"
  },
  "devDependencies": {
    "@oreva/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
